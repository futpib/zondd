{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zondd local credential API v1",
  "description": "NDJSON frames. Byte limits, connection ordering and recipient authorization are enforced in addition to this schema.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "$defs": {
    "field": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 32
        }
      },
      "required": [
        "id",
        "label",
        "kind"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "choice"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "choices"
            ],
            "properties": {
              "choices": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "body": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "method": {
                  "const": "authenticate"
                },
                "recipient": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "key": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "method",
                "recipient",
                "key"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "method": {
                  "const": "challenge"
                },
                "origin": {
                  "type": "string"
                },
                "prompt": {
                  "type": "string",
                  "maxLength": 4096,
                  "default": ""
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/field"
                  },
                  "minItems": 1,
                  "maxItems": 16
                },
                "context": {},
                "timeout_secs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400,
                  "default": 300
                }
              },
              "required": [
                "method",
                "origin",
                "fields"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "method": {
                  "const": "withdraw"
                },
                "challenge_id": {
                  "type": "string"
                }
              },
              "required": [
                "method",
                "challenge_id"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "method": {
                  "const": "result"
                },
                "challenge_id": {
                  "type": "string"
                },
                "outcome": {
                  "enum": [
                    "succeeded",
                    "failed",
                    "cancelled"
                  ]
                }
              },
              "required": [
                "method",
                "challenge_id",
                "outcome"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "version",
        "id",
        "body"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "body": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "ready"
                },
                "session_id": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "session_id"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "opened"
                },
                "challenge_id": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "challenge_id"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "answered"
                },
                "challenge_id": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "answered",
                    "rejected",
                    "expired",
                    "withdrawn",
                    "disconnected",
                    "interrupted",
                    "recipient_changed"
                  ]
                },
                "values": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string",
                        "maxLength": 4096
                      }
                    }
                  ]
                }
              },
              "required": [
                "type",
                "challenge_id",
                "status",
                "values"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "recorded"
                },
                "challenge_id": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "challenge_id"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "error"
                },
                "code": {
                  "enum": [
                    "unsupported_version",
                    "authentication_failed",
                    "busy",
                    "unavailable",
                    "invalid_frame",
                    "already_authenticated",
                    "session_closed",
                    "origin_not_allowed",
                    "field_not_allowed",
                    "invalid_challenge",
                    "result_required",
                    "queue_full",
                    "unknown_challenge",
                    "answer_delivered",
                    "invalid_outcome"
                  ]
                }
              },
              "required": [
                "type",
                "code"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "version",
        "id",
        "body"
      ],
      "additionalProperties": false
    }
  }
}
