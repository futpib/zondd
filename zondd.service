[Unit]
Description=zondd — SSH-authenticated operations and approval queue

[Service]
ExecStart=%h/.cargo/bin/zondd serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
RuntimeDirectory=zondd
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
KillMode=control-group
TimeoutStopSec=5

[Install]
WantedBy=default.target
